# =====================================
# OTEL configurations
# =====================================

# Allow-list baggage attributes
OTEL_BAGGAGE_SPAN_ATTRIBUTE_KEYS=session.id,tenant.id,user.id

# To opt out of ADOT GenAI content extraction (prevents prompt/completion content from being captured in traces)
AWS_GENAI_CONTENT_EXTRACTION_OPT_OUT=true

# To enable experimental OpenTelemetry GenAI semantic conventions on the agent
OTEL_SEMCONV_STABILITY_OPT_IN=true

# =====================================
# Gateway interceptor configurations
# =====================================

# Attach the Lambda request interceptor to the AgentCore Gateway (default: false)
ENABLE_GW_REQUEST_INTERCEPTOR=false

# Attach the Lambda response interceptor to the AgentCore Gateway (default: false)
ENABLE_GW_RESPONSE_INTERCEPTOR=false

# =====================================
# Other configurations
# =====================================

# [Optional] if using alternative docker tools
# CDK_DOCKER=finch
